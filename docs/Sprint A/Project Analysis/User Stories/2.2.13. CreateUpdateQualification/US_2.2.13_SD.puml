@startuml 2.2.13_Qualifications_Create
title 2.2.13 – Create Qualification
autonumber
actor LO as "Logistics Operator"
participant UI as "SPA / WebApp"
participant API as "PortOps API (.NET)"
participant IAM as "External IAM (JWT)"
participant RB as "Authorizer (RBAC)"
database DB as "EF Core / DB"

LO -> UI : Fill form {code, name} & Submit
UI -> API : POST /api/qualifications {code, name} + Bearer JWT
API -> IAM : Validate/Introspect JWT
IAM --> API : Valid (roles: LOGISTICS_OPERATOR)
API -> RB : Check role(LOGISTICS_OPERATOR)
RB --> API : Allowed

API -> DB : SELECT Qualification WHERE lower(code)=lower(:code)
DB --> API : Not found
API -> DB : INSERT Qualification(code,name,timestamps)
DB --> API : Created
API --> UI : 201 Created {code,name,createdAt,...}
UI --> LO : Success

alt Duplicate code
  API -> DB : SELECT by code
  DB --> API : Found
  API --> UI : 409 Conflict "code must be unique"
end

alt Invalid payload
  API --> UI : 400/422 Validation errors
end
@enduml

@startuml 2.2.13_Qualifications_Update
title 2.2.13 – Update Qualification (name)
autonumber
actor LO as "Logistics Operator"
participant UI as "SPA"
participant API as "PortOps API"
participant RB as "Authorizer (RBAC)"
database DB as "EF Core / DB"

LO -> UI : Edit name & Save
UI -> API : PATCH /api/qualifications/{code} {name}
API -> RB : Check role(LOGISTICS_OPERATOR)
RB --> API : Allowed
API -> DB : SELECT Qualification by {code}
DB --> API : Found
API -> DB : UPDATE name, updatedAt
DB --> API : OK
API --> UI : 200 OK {code,name,...}

else Not found
  DB --> API : null
  API --> UI : 404 Not Found
end
@enduml

@startuml 2.2.13_Qualifications_Search
title 2.2.13 – Search Qualifications
autonumber
actor LO as "Logistics Operator"
participant UI as "SPA"
participant API as "PortOps API"
database DB as "EF Core / DB"

LO -> UI : Search by code/name
UI -> API : GET /api/qualifications?code=...&name=...
API -> DB : SELECT ... WHERE code LIKE ? OR name LIKE ? ORDER BY code
DB --> API : Rows[]
API --> UI : 200 OK [ {code,name}, ... ]
UI --> LO : Render table (paginated)
@enduml
